{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorkPet",
  "version": "0.2.0",
  "identifier": "com.linlis.workpet",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "pet",
        "title": "WorkPet",
        "width": 300,
        "height": 420,
        "minWidth": 225,
        "minHeight": 315,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}

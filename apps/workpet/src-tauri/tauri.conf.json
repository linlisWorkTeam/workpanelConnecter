{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorkPet",
  "version": "0.1.0",
  "identifier": "com.linlis.workpet",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "pet",
        "title": "WorkPet",
        "width": 120,
        "height": 120,
        "minWidth": 120,
        "minHeight": 120,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
